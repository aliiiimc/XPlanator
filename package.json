{
  "name": "xplanator",
  "displayName": "XPlanator",
  "description": "Understand selected code in VS Code with OpenAI/Codex, Claude, Gemini, or local Ollama explanations.",
  "version": "0.2.0",
  "publisher": "aliiiimc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliiiimc/XPlanator.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "xplanator",
    "ollama",
    "local-first",
    "byok",
    "ai",
    "explain",
    "code-explanation",
    "learning",
    "education",
    "beginner",
    "typescript",
    "python",
    "javascript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "explainCode.openPanel",
        "title": "XPlanator: Open Panel",
        "category": "XPlanator",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "explainCode.explainSelection",
        "title": "Explain Code: Explain Selection",
        "category": "Explain Code"
      },
      {
        "command": "explainCode.explainAtCursor",
        "title": "Explain Code: Explain At Cursor",
        "category": "Explain Code"
      },
      {
        "command": "explainCode.explainWithContext",
        "title": "XPlanator: Explain with Context Mode",
        "category": "XPlanator"
      },
      {
        "command": "explainCode.explainMoreSimply",
        "title": "Explain Code: Explain More Simply",
        "category": "Explain Code"
      },
      {
        "command": "explainCode.explainInMoreDetail",
        "title": "Explain Code: Explain In More Detail",
        "category": "Explain Code"
      },
      {
        "command": "explainCode.openSettings",
        "title": "Explain Code: Open Settings",
        "category": "Explain Code"
      },
      {
        "command": "explainCode.checkOllama",
        "title": "Explain Code: Check AI Provider Connection",
        "category": "Explain Code"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "explainCode.openPanel",
          "group": "navigation@9",
          "when": "editorTextFocus"
        }
      ],
      "editor/context": [
        {
          "command": "explainCode.explainSelection",
          "group": "navigation@10",
          "when": "editorTextFocus"
        },
        {
          "command": "explainCode.explainAtCursor",
          "group": "navigation@11",
          "when": "editorTextFocus"
        },
        {
          "command": "explainCode.explainWithContext",
          "group": "navigation@12",
          "when": "editorTextFocus"
        }
      ]
    },
    "keybindings": [
      {
        "command": "explainCode.explainSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Explain Code",
      "properties": {
        "explainCode.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL of your local Ollama server."
        },
        "explainCode.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai",
            "gemini",
            "anthropic",
            "meta"
          ],
          "default": "openai",
          "description": "Explanation provider used by XPlanator. Ollama stays local; cloud providers require an API key."
        },
        "explainCode.openAiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL for OpenAI or OpenAI-compatible APIs."
        },
        "explainCode.anthropicBaseUrl": {
          "type": "string",
          "default": "https://api.anthropic.com/v1",
          "description": "Base URL for Anthropic or Anthropic-compatible Messages APIs."
        },
        "explainCode.model": {
          "type": "string",
          "default": "",
          "description": "Legacy model setting used when migrating to provider profiles. Choose a model in the XPlanator settings."
        },
        "explainCode.maxSurroundingLines": {
          "type": "number",
          "default": 20,
          "minimum": 10,
          "maximum": 200,
          "description": "Maximum number of surrounding lines sent as context from the current file."
        },
        "explainCode.responseStyle": {
          "type": "string",
          "enum": [
            "simple",
            "technical",
            "beginner"
          ],
          "default": "beginner",
          "description": "Default tone used for quick explanations."
        },
        "explainCode.responseLength": {
          "type": "string",
          "enum": ["short", "medium", "long"],
          "default": "medium",
          "description": "Preferred maximum length for generated explanations."
        },
        "explainCode.explanationSections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "summary",
              "details",
              "takeaway"
            ]
          },
          "default": [
            "summary",
            "details",
            "takeaway"
          ],
          "description": "Sections generated by XPlanator. Choose fewer sections to reduce output tokens."
        },
        "explainCode.language": {
          "type": "string",
          "enum": [
            "fr",
            "en"
          ],
          "default": "fr",
          "description": "Language used for AI explanations and UI labels."
        },
        "explainCode.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 180,
          "description": "Timeout in seconds for AI provider HTTP requests."
        },
        "explainCode.includeRelatedContext": {
          "type": "boolean",
          "default": false,
          "description": "Include extra workspace snippets from definitions and references when available."
        },
        "explainCode.historyEnabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Opt in to local history. It stores code snapshots, explanations and questions on this device; sensitive-data detection is best effort."
        },
        "explainCode.historyLimit": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "scope": "application",
          "description": "Maximum number of locally stored explanations."
        },
        "explainCode.maxRelatedSnippets": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 8,
          "description": "Maximum number of related workspace snippets to attach for context."
        },
        "explainCode.maxRelatedLinesPerSnippet": {
          "type": "number",
          "default": 28,
          "minimum": 8,
          "maximum": 80,
          "description": "Maximum lines captured for each related workspace snippet."
        },
        "explainCode.maxContextCharacters": {
          "type": "number",
          "default": 8000,
          "minimum": 4000,
          "maximum": 120000,
          "description": "Overall character budget for extra related context. Increase this for larger cloud models."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/*.test.js test/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.9.2"
  }
}
